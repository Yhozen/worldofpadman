{
  "name": "wop-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/smoke.mjs",
    "serve": "node scripts/serve.mjs",
    "plan": "pnpm build && alchemy plan --stage preview --profile default",
    "deploy": "pnpm build && alchemy deploy --stage preview --profile default"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["workerd"],
    "overrides": {
      "@effect/platform-node-shared": "4.0.6",
      "@effect/sql-d1": "4.0.6"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "24.19.2",
    "playwright-core": "1.64.1",
    "rolldown": "1.2.13",
    "typescript": "6.0.3",
    "workerd": "1.20261012.1"
  }
}
